<?xml version="1.0" encoding="utf-8"?>
<!--
  Health data is excluded from cloud backup and from device-to-device transfer. It stays on the
  phone that recorded it unless the user deliberately exports it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
